{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true
	},
	"include": ["index.ts", "src/**/*.ts", "bin/**/*.ts", "test/**/*.ts", "examples/**/*.ts"],
	"exclude": ["node_modules"]
}
